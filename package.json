{
  "name": "zeronerp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "preview": "node scripts/run-with-env.mjs npx opennextjs-cloudflare build && node scripts/run-with-env.mjs npx opennextjs-cloudflare preview",
    "deploy": "node scripts/run-with-env.mjs npx opennextjs-cloudflare build && node scripts/run-with-env.mjs npx opennextjs-cloudflare deploy",
    "upload": "node scripts/run-with-env.mjs npx opennextjs-cloudflare build && node scripts/run-with-env.mjs npx opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply zeronerpdb --local",
    "db:migrate:remote": "node scripts/run-with-env.mjs npx wrangler d1 migrations apply zeronerpdb --remote",
    "db:execute:remote": "node scripts/run-with-env.mjs npx wrangler d1 execute zeronerpdb --remote",
    "db:generate": "drizzle-kit generate",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "db:seed-fg-items": "node scripts/seed-fg-items.mjs",
    "db:seed-rm-items": "node scripts/seed-rm-items.mjs",
    "db:seed-sample-recipes": "node scripts/seed-sample-recipes.mjs",
    "db:reset-admin": "node scripts/run-with-env.mjs node scripts/reset-admin-password.mjs",
    "secrets:jwt": "node scripts/run-with-env.mjs node scripts/set-jwt-secret.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.90.0"
  }
}
