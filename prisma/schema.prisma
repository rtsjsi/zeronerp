// ============================================
// ZeronERP — Prisma Schema (Simplified)
// Multi-tenant ERP with soft deletes & audit
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// ─── TENANT ─────────────────────────────────────────

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  domain      String?
  logo        String?
  settings    Json     @default("{}")
  customTerms Json     @default("{}")
  aiEnabled   Boolean  @default(true)
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  @db.Uuid

  users       User[]
  auditLogs   AuditLog[]

  @@schema("public")
}

// ─── USER ───────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  email         String
  fullName      String
  avatarUrl     String?
  phone         String?
  whatsapp      String?
  supabaseUid   String   @unique        // maps to Supabase Auth user
  isActive      Boolean  @default(true)
  isDeleted     Boolean  @default(false)
  customFields  Json     @default("{}")
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?  @db.Uuid

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  auditLogs     AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([supabaseUid])
  @@schema("public")
}

// ─── AUDIT LOG ──────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  entity     String               // e.g. "Item", "SalesOrder"
  entityId   String   @db.Uuid
  action     String               // "create" | "update" | "delete"
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entity, entityId])
  @@index([tenantId, createdAt])
  @@schema("public")
}

// ─── CONFIG ENGINE ──────────────────────────────────

model CustomFieldDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  entity       String               // e.g. "Item", "Customer"
  fieldName    String
  fieldLabel   String
  fieldType    String               // "text" | "number" | "date" | "select" | "boolean"
  options      Json?                // for select fields: ["Option A", "Option B"]
  isRequired   Boolean  @default(false)
  sortOrder    Int      @default(0)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  @db.Uuid

  @@unique([tenantId, entity, fieldName])
  @@index([tenantId, entity])
  @@schema("public")
}

// ─── INVENTORY ─────────────────────────────────────────

model Item {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  sku          String
  name         String
  description  String?
  uom          String   @default("pcs")
  basePrice    Decimal  @default(0) @db.Decimal(12, 2)
  customFields Json     @default("{}")
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  @db.Uuid

  stocks       Stock[]
  transactions InventoryTransaction[]
  poItems      PurchaseOrderItem[]
  soItems      SalesOrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@schema("public")
}

model Warehouse {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  code         String
  location     String?
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  @db.Uuid

  stocks       Stock[]
  transactions InventoryTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@schema("public")
}

model Stock {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  itemId       String   @db.Uuid
  warehouseId  String   @db.Uuid
  quantity     Decimal  @default(0) @db.Decimal(12, 3)
  reserved     Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt    DateTime @updatedAt

  item         Item      @relation(fields: [itemId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
  @@index([tenantId])
  @@schema("public")
}

model InventoryTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  itemId       String   @db.Uuid
  warehouseId  String   @db.Uuid
  type         String               // "IN" | "OUT" | "MOVE"
  quantity     Decimal  @db.Decimal(12, 3)
  reference    String?              // e.g. "PO-123", "SO-456"
  performedBy  String?  @db.Uuid
  createdAt    DateTime @default(now())

  item         Item      @relation(fields: [itemId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([itemId])
  @@schema("public")
}

// ─── PROCUREMENT ──────────────────────────────────────

model Vendor {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  customFields Json     @default("{}")
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  @db.Uuid

  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@schema("public")
}

model PurchaseOrder {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  vendorId     String   @db.Uuid
  poNumber     String
  status       String   @default("DRAFT")
  totalAmount  Decimal  @default(0) @db.Decimal(12, 2)
  notes        String?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  @db.Uuid

  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  items        PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@schema("public")
}

model PurchaseOrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  poId         String   @db.Uuid
  itemId       String   @db.Uuid
  quantity     Decimal  @db.Decimal(12, 3)
  unitPrice    Decimal  @db.Decimal(12, 2)
  totalPrice   Decimal  @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  item          Item          @relation(fields: [itemId], references: [id])

  @@schema("public")
}

// ─── SALES ──────────────────────────────────────────

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  customFields Json     @default("{}")
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  @db.Uuid

  salesOrders  SalesOrder[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@schema("public")
}

model SalesOrder {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  customerId   String   @db.Uuid
  soNumber     String
  status       String   @default("DRAFT")
  totalAmount  Decimal  @default(0) @db.Decimal(12, 2)
  notes        String?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?  @db.Uuid

  customer     Customer         @relation(fields: [customerId], references: [id])
  items        SalesOrderItem[]

  @@unique([tenantId, soNumber])
  @@index([tenantId])
  @@schema("public")
}

model SalesOrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  soId         String   @db.Uuid
  itemId       String   @db.Uuid
  quantity     Decimal  @db.Decimal(12, 3)
  unitPrice    Decimal  @db.Decimal(12, 2)
  totalPrice   Decimal  @db.Decimal(12, 2)

  salesOrder   SalesOrder @relation(fields: [soId], references: [id])
  item         Item       @relation(fields: [itemId], references: [id])

  @@schema("public")
}
